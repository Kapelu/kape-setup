  $SUDO apt-get install -y gnome-shell-extension-appindicator gnome-shell-extension-prefs

  # --- LIMPIEZA ---
  $SUDO rm -f "$TMP_DEB"

  log_print OK "Proton VPN instalado correctamente"
}
