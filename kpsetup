#* Valida si la distro es UBUNTU
VALIDAR_DISTRO() {
  log_print info "Validando distribución..."

  if [[ -r /etc/os-release ]]; then
    . /etc/os-release
  else
    log_print ERROR "No se pudo leer /etc/os-release"
    print_banner "⛔ No se pudo detectar la Distro"
    exit 1
  fi

  log_print OK "ID=$ID VERSION_ID=$VERSION_ID ID_LIKE=$ID_LIKE"

  case "$ID" in
    ubuntu)
      case "$VERSION_ID" in
        24.*|26.*)
          log_print OK "Ubuntu compatible: $VERSION_ID"
          ;;
        *)
          clear
          print_banner "⛔ Ubuntu no soportado: $VERSION_ID"
          exit 1
          ;;
      esac
      ;;
      
    debian)
      case "$VERSION_ID" in
        12|13)
          log_print OK "Debian compatible: $VERSION_ID"
          ;;
        *)
          clear
          print_banner "⛔ Debian no soportado: $VERSION_ID"
          exit 1
          ;;
      esac
      ;;
      
    *)
      # fallback usando ID_LIKE (más robusto)
      if [[ "$ID_LIKE" =~ debian ]]; then
        log_print WARN "Distro derivada detectada ($ID), tratada como Debian-like"
      else
        clear
        print_banner "⛔ Distro no soportada: $ID"
        exit 1
      fi
      ;;
  esac

  log_print info "Sistema validado correctamente"
}

#* Funcion que actualiza APT
UPDATE() {
  log_print info "Actualizando sistema..."

  export DEBIAN_FRONTEND=noninteractive
  export NEEDRESTART_MODE=a
  export APT_LISTCHANGES_FRONTEND=none

  echo "code code/add-microsoft-repo boolean true" | sudo debconf-set-selections

  log_print info "PASO 1: apt update"
  if ! $SUDO apt-get update -y; then
    log_print verifail "Error en apt-get update"
    return 1
  fi
  log_print info "PASO 2: dist-upgrade"
  if ! $SUDO -E apt-get \
    -y \
    -o Dpkg::Options::="--force-confdef" \
    -o Dpkg::Options::="--force-confold" \
    -o Dpkg::Use-Pty=0 \
    dist-upgrade; then

    log_print error "Error en dist-upgrade"
    return 1
  fi
  log_print info "PASO 3: autoremove"
  # Limpieza del sistema
  if ! $SUDO apt-get autoremove -y; then
    log_print warn "Error en autoremove"
  fi
  log_print info "PASO 4: autoclean"
  if ! $SUDO apt-get autoclean -y; then
    log_print warn "Error en autoclean"
  fi

  log_print ok "Sistema actualizado correctamente."
}

#* Funcion de limpieza del sistema
CLEAN_SYSTEM() {
    log_print info "🧹 Iniciando limpieza del sistema..."
    # Limpiar paquetes innecesarios
    log_print ok "➤ Eliminando paquetes huérfanos..."
    $SUDO apt-get autoremove -y
    # Limpiar caché de paquetes descargados
    log_print ok "➤ Limpiando caché de APT..."
    $SUDO apt-get clean
    $SUDO apt-get autoclean
    # Limpiar logs antiguos
    log_print ok "➤ Limpiando logs antiguos..."
    $SUDO journalctl --vacuum-time=7d
    # Limpiar miniaturas (thumbnails)
    log_print ok "➤ Eliminando caché de miniaturas..."
    $SUDO rm -rf "$USER_HOME/.cache/thumbnails/"*
    # Limpiar caché de usuario
    log_print ok "➤ Limpiando caché del usuario..."
    rm -rf "$USER_HOME/.cache/"*
    # Limpiar paquetes snap si existen
    if command -v snap >/dev/null 2>&1; then
        log_print ok "➤ Limpiando versiones antiguas de Snap..."
        snap list --all | awk '/disabled/{print $1, $3}' | while read snapname revision; do
            snap remove "$snapname" --revision="$revision"
        done
    fi
		# Eliminar paquetes en estado "rc" (residuos de configs)
		log_print ok "➤ Eliminando paquetes residuales..."
		dpkg -l | awk '/^rc/ { print $2 }' | xargs -r $SUDO apt-get purge -y
    log_print ok " Limpieza completada."
		sleep 3
}
#* Función full update que llama a update_system y agrega Snap, Flatpak y firmware
FULL_UPDATE() {
  UPDATE || return 1

  # Snap
  if command -v snap >/dev/null 2>&1 && systemctl is-active --quiet snapd; then
    log_print info "➤ Actualizando paquetes Snap..."
    $SUDO snap refresh || log_print warn "Snap refresh falló"
  fi

  # Flatpak
  if command -v flatpak >/dev/null 2>&1; then
    if flatpak remotes | grep -q .; then
      log_print info "➤ Actualizando paquetes Flatpak..."
      $SUDO flatpak update -y || log_print warn "Flatpak update falló"
    else
      log_print warn "Flatpak sin repos configurados"
    fi
  fi

  # Firmware
  if [ -d /sys/firmware/efi ] && command -v fwupdmgr >/dev/null 2>&1; then
    log_print info "➤ Actualizando firmware (UEFI)..."
    $SUDO fwupdmgr refresh --force || log_print warn "fwupdmgr refresh falló"
    $SUDO fwupdmgr update -y || log_print warn "fwupdmgr update falló"
  else
    log_print warn "➤ Sistema en modo Legacy BIOS o fwupdmgr no disponible"
  fi

  log_print ok "Actualización completa finalizada."
}

#* PERSONALIZE_UBUNTU: Función que personaliza Escritorio y temas visuales, energia, dock y seguridad
PERSONALIZE_UBUNTU() {
  log_print info "Personalizando .bashrc"

  # USER
  rebuild_bashrc "$USER_HOME/.bashrc"

  chown "$REAL_USER:$REAL_USER" "$USER_HOME/.bashrc"

  # ROOT
  if [ "$(id -u)" -eq 0 ]; then
    rebuild_bashrc "$ROOT_HOME/.bashrc"
    chown root:root "$ROOT_HOME/.bashrc"
  else
    sudo bash -c "$(declare -f versioned_write rebuild_bashrc); rebuild_bashrc '$ROOT_HOME/.bashrc'"
    sudo chown root:root "$ROOT_HOME/.bashrc"
  fi

  # RECARGA
  if [ -n "${REAL_USER:-}" ] && [ "$REAL_USER" != "root" ]; then
  sudo -u "$REAL_USER" bash -c "source ~/.bashrc"
  fi

  log_print ok "✔ Personalización completa"
}

#* INSTALL_SNAP: Instala paquetes snap declarados en SNAP_TOOLS
INSTALL_SNAP(){
  log_print info "Instalando paquetes snap desde SNAP_TOOLS..."

  if ! command -v snap >/dev/null 2>&1; then
    log_print warn "snap no está instalado. Instalando snapd..."
    #$SUDO apt-get update -y
    $SUDO apt-get install -y snapd
    $SUDO systemctl enable --now snapd
    ln -sf /var/lib/snapd/snap /snap
  else
    log_print ok "snap disponible"
  fi

  log_print info "Obteniendo lista de snaps instalados..."
  local installed
  installed="$(snap list | awk 'NR>1{print $1}')"

  local pkg pkg_name
  for pkg in "${SNAP_TOOLS[@]}"; do
    # Extrae solo el nombre del paquete (primer palabra)
    pkg_name="${pkg%% *}"

    if echo "$installed" | grep -qx "$pkg_name"; then
      log_print ok "$pkg_name ya está instalado"
    else
      log_print info "Instalando $pkg..."
      if $SUDO snap install "${args[@]}"; then
        log_print ok "$pkg_name instalado ✔"
      else
       log_print error "Error instalando $pkg_name"
      fi
    fi
  done

  log_print ok "Instalación de paquetes SNAP finalizado"
}

#* INSTALL_APT: Instala paquetes usando APT_TOOLS
INSTALL_APT() {
  local pkg
  log_print info "Instalando paquetes desde APT_TOOLS..."

  for pkg in "${APT_TOOLS[@]}"; do
    if ! dpkg -s "$pkg" &>/dev/null; then
      log_print run "Instalando paquete: $pkg..."
      
      if ! $SUDO apt-get install -y "$pkg"; then
        log_print warn "Paquete defectuoso: $pkg. Intentando desinstalar..."
        $SUDO apt-get remove -y "$pkg" 2>/dev/null
      else
        log_print ok "Instalado correctamente: $pkg"
      fi
    else
      log_print info "Ya está instalado: $pkg"
    fi
  done
  log_print ok "Instalación de pauqetes APT finalizado"
}

