	log_print ok "Versión" timeshift --version
  else
    log_print ERROR "Timeshift no se encuentra después de la instalación"
    return 1
  fi
}

#* INSTALL_FOLIATE: Instala lector .epub desde el repositorio APT
INSTALL_FOLIATE() {
  log_print RUN "Instalando Foliate..."

  if ! $SUDO apt update; then
    log_print ERROR "No se pudo actualizar la lista de paquetes."
    return 1
  fi

  if ! $SUDO apt install -y foliate; then
    log_print ERROR "No se pudo instalar Foliate."
    return 1
  fi

  log_print OK "Foliate instalado correctamente."
}

