# BUSCAR package.json HACIA ARRIBA
find_package_json_upwards() {
  local dir="$PWD"
  while [ "$dir" != "/" ]; do
    [ -f "$dir/package.json" ] && { echo "$dir/package.json"; return; }
    dir=$(dirname "$dir")
  done
}

# DETECTAR PACKAGE MANAGER (robusto)
detect_package_manager() {
  local pkg_json manager dir="$PWD"

  pkg_json=$(find_package_json_upwards)

  if [ -n "$pkg_json" ]; then
    if command -v jq >/dev/null 2>&1; then
      manager=$(jq -r '.packageManager // empty' "$pkg_json" 2>/dev/null | cut -d@ -f1)
    else
      manager=$(grep -o '"packageManager"[[:space:]]*:[[:space:]]*"[^"]*"' "$pkg_json" \
        | sed -E 's/.*"([^"]+)".*/\1/' | cut -d@ -f1)
    fi
    [ -n "$manager" ] && { echo "$manager"; return; }
  fi

  while [ "$dir" != "/" ]; do
    [ -f "$dir/pnpm-lock.yaml" ] && { echo "pnpm"; return; }
    [ -f "$dir/yarn.lock" ] && { echo "yarn"; return; }
    [ -f "$dir/package-lock.json" ] && { echo "npm"; return; }
    dir=$(dirname "$dir")
  done

  echo "npm"
}

# ENSURE PNPM
ensure_pnpm() {
  command -v pnpm >/dev/null 2>&1 && return

  local dir="$PWD"
  while [ "$dir" != "/" ]; do
    [ -f "$dir/pnpm-lock.yaml" ] && {
      echo "📦 Instalando pnpm..."
      npm install -g pnpm >/dev/null 2>&1
      return
    }
    dir=$(dirname "$dir")
  done
}

# RUNNER UNIVERSAL
runpkg() {
  local gestor
  gestor=$(detect_package_manager)
  ensure_pnpm
  command "$gestor" "$@"
}

# GIT PROMPT OPTIMIZADO
git_prompt_status() {
  git rev-parse --is-inside-work-tree &>/dev/null || return

  local branch dirty ahead behind
  branch=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD)

  # Cambios locales reales
  if ! git diff --quiet --ignore-submodules --cached || ! git diff --quiet --ignore-submodules; then
    dirty=1
  fi

  # Conflictos
  if git ls-files -u | grep -q .; then
    printf "\033[38;5;196m[%s]\033[0m" "$branch"  # 🔴 conflictos
    return
  fi

  # Ahead / Behind respecto al upstream
  if git rev-parse --abbrev-ref @{u} &>/dev/null; then
    read ahead behind < <(git rev-list --left-right --count HEAD...@{u})
  else
    ahead=0
    behind=0
  fi

  if [ "$dirty" = "1" ]; then
    printf "\033[38;5;220m[%s]\033[0m" "$branch"      # 🟡 cambios locales
  elif [ "$ahead" -gt 0 ] || [ "$behind" -gt 0 ]; then
    printf "\033[38;5;33m[%s]\033[0m" "$branch"       # 🔵 no sincronizado (push/pull)
  else
    printf "\033[38;5;82m[%s]\033[0m" "$branch"       # 🟢 limpio y sincronizado
  fi
}
